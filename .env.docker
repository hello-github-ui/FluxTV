# Docker 环境变量配置文件

# MySQL 配置
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=fluxtv
MYSQL_USER=fluxtv
MYSQL_PASSWORD=fluxtv123456

# JWT 密钥（生产环境请修改为随机字符串）
JWT_SECRET=your-secret-key-change-in-production

# 前端 API 地址（根据你的服务器地址修改）
# 本地测试使用：http://localhost:3001/api
# 服务器部署使用：http://your-server-ip:3001/api 或 https://your-domain.com/api
REACT_APP_API_URL=http://localhost:3001/api
